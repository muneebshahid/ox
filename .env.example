# auth mode: "api" (OPENAI_API_KEY) or "subscription" (reuse Codex login token)
AUTH_MODE=api
OPENAI_API_KEY=sk-...
# Tool-capable model name. Examples: gpt-4.1-mini, gpt-4.1, gpt-5
OPENAI_MODEL=gpt-4.1-mini
# Reasoning effort. Valid values:
# off|none|minimal|low|medium|high|xhigh
# If unset or invalid, ox defaults to medium.
OPENAI_REASONING=medium
